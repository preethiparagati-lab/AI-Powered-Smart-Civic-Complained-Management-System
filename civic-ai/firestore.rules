rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // New accounts can only be created as citizens. Promote admins manually in the Firebase console.
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.role == 'citizen';
      allow update: if signedIn() && request.auth.uid == uid
                    && request.resource.data.role == resource.data.role;
    }

    match /complaints/{id} {
      allow read: if true;

      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'submitted';

      allow update: if isAdmin()
        // anyone signed in may add their own "me too" support
        || (signedIn()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['supporters'])
            && request.resource.data.supporters.size() <= resource.data.supporters.size() + 1)
        // the reporter may leave feedback once resolved
        || (signedIn()
            && resource.data.uid == request.auth.uid
            && resource.data.status == 'resolved'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['feedback']));

      allow delete: if isAdmin();
    }
  }
}
